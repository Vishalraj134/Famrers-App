# ===========================
# Root .gitignore
# ===========================

# Node modules (NEVER commit these)
node_modules/
**/node_modules/

# Environment files (NEVER commit real secrets)
.env
**/.env
# Allow .env.example (template with no real values)
!**/.env.example

# Build outputs
**/dist/
**/build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files (use Railway's hosted DB instead)
*.sqlite
*.sqlite3
*.db

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Uploaded files (use Cloudinary/S3 in production)
server/uploads/*
!server/uploads/.gitkeep
