# ============================================================
# SERVER ENVIRONMENT VARIABLES — EXAMPLE (safe to commit)
# ============================================================
# 1. Copy this file to .env
# 2. Fill in the real values
# 3. NEVER commit your real .env to git
# ============================================================

# ── Database ──
# Get these from Railway → MySQL plugin → Connect tab
DB_HOST=your-mysql-host.railway.internal
DB_USER=root
DB_PASS=your_database_password_here
DB_NAME=railway
DB_PORT=3306

# ── JWT ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# ── Server ──
PORT=5000
NODE_ENV=production

# ── CORS ──
# Your deployed frontend URL (comma-separated for multiple)
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app
